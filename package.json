{
  "name": "aicaddypro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage",
    "test:a11y": "jest --testPathPatterns=a11y --passWithNoTests",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "setup": "yarn install && node -e \"const fs=require('fs'); if(!fs.existsSync('.env.local')){fs.copyFileSync('.env.example','.env.local');console.log('Created .env.local from template');}\"",
    "check:unused": "knip",
    "check:unused:fix": "knip --fix",
    "todo:check": "node -e \"const{execSync}=require('child_process');const r=execSync('git grep -n -E \\\"TODO|FIXME|HACK|XXX\\\" -- \\\"*.ts\\\" \\\"*.tsx\\\" || true',{encoding:'utf8'});if(r){console.log('Tech debt items found:');console.log(r);process.exit(0);}else{console.log('No TODO/FIXME comments found');}\"",
    "check:dupes": "jscpd ./src ./app --config .jscpd.json",
    "docs": "typedoc --out docs/api src/lib/*.ts src/hooks/*.ts",
    "align": "npx expo-doctor && npx expo install",
    "postinstall": "npx patch-package && node scripts/fix-rn-gradle-plugin.js && npm run rebuild:rn-gradle-plugin",
    "rebuild:rn-gradle-plugin": "node scripts/rebuild-rn-gradle-plugin.js",
    "setup:maven": "node_modules/@react-native/gradle-plugin/gradlew.bat :react-native-gradle-plugin:jar -x test && node -e \"const fs=require('fs');const path=require('path');const rnVersion=require('./node_modules/@react-native/gradle-plugin/package.json').version;const dir=`android/local-maven-repo/com/facebook/react/react-native-gradle-plugin/${rnVersion}`;fs.mkdirSync(dir,{recursive:true});fs.copyFileSync('node_modules/@react-native/gradle-plugin/react-native-gradle-plugin/build/libs/react-native-gradle-plugin.jar',path.join(dir,`react-native-gradle-plugin-${rnVersion}.jar`));fs.writeFileSync(path.join(dir,`react-native-gradle-plugin-${rnVersion}.pom`),`<?xml version=\\\"1.0\\\"?><project><modelVersion>4.0.0</modelVersion><groupId>com.facebook.react</groupId><artifactId>react-native-gradle-plugin</artifactId><version>${rnVersion}</version><packaging>jar</packaging></project>`);\"",
    "prepare": "husky",
    "lint": "expo lint",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "storybook-generate": "sb-rn-get-stories"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "<rootDir>/components/__tests__/",
      "<rootDir>/.worktrees/",
      "<rootDir>/e2e/"
    ],
    "maxWorkers": "50%",
    "verbose": true,
    "testTimeout": 10000,
    "randomize": true,
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/types.ts"
    ],
    "reporters": [
      "default"
    ]
  },
  "dependencies": {
    "@babel/core": "^7.28.6",
    "@expo/metro-runtime": "6.2.0-canary-20260114-d8e19f5",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lodev09/react-native-true-sheet": "^3.7.3",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/slider": "5.1.1",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@storybook/addon-ondevice-actions": "^10.1.11",
    "@storybook/addon-ondevice-controls": "^10.1.11",
    "@storybook/react-native": "^10.1.11",
    "babel-loader": "^8.4.1",
    "expo": "55.0.0-canary-20260114-d8e19f5",
    "expo-blur": "16.0.0-canary-20260114-d8e19f5",
    "expo-constants": "18.1.0-canary-20260114-d8e19f5",
    "expo-dev-client": "6.1.0-canary-20260114-d8e19f5",
    "expo-file-system": "19.0.22-canary-20260114-d8e19f5",
    "expo-font": "14.1.0-canary-20260114-d8e19f5",
    "expo-glass-effect": "0.2.0-canary-20260114-d8e19f5",
    "expo-haptics": "15.0.9-canary-20260114-d8e19f5",
    "expo-linear-gradient": "15.0.9-canary-20260114-d8e19f5",
    "expo-linking": "8.0.12-canary-20260114-d8e19f5",
    "expo-location": "19.1.0-canary-20260114-d8e19f5",
    "expo-notifications": "1.0.0-canary-20260114-d8e19f5",
    "expo-router": "7.0.0-canary-20260114-d8e19f5",
    "expo-sensors": "15.0.9-canary-20260114-d8e19f5",
    "expo-splash-screen": "31.0.14-canary-20260114-d8e19f5",
    "expo-status-bar": "3.0.10-canary-20260114-d8e19f5",
    "expo-system-ui": "6.0.10-canary-20260114-d8e19f5",
    "expo-updates": "29.1.0-canary-20260114-d8e19f5",
    "expo-web-browser": "15.0.11-canary-20260114-d8e19f5",
    "lucide-react-native": "0.562.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-purchases": "^9.7.0",
    "react-native-purchases-ui": "^9.7.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.19.0",
    "react-native-svg": "15.15.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.1",
    "storybook": "^10.1.11",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "10.0.1-canary-20260114-d8e19f5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "55.0.0-canary-20260114-d8e19f5",
    "jscpd": "^4.0.7",
    "knip": "^5.81.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.0",
    "typedoc": "0.28.3",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "react-native-reanimated",
        "react-native-gesture-handler",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@expo/metro-runtime",
          "lucide-react-native"
        ]
      }
    }
  },
  "resolutions": {
    "eslint-plugin-react-native-a11y": "^3.5.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
