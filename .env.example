# AICaddy Pro Environment Variables
# Copy this file to .env.local and fill in your API keys

# Weather APIs (at least one required)
EXPO_PUBLIC_TOMORROW_API_KEY=your-tomorrow-api-key
EXPO_PUBLIC_OPENWEATHER_API_KEY=your-openweather-api-key
EXPO_PUBLIC_WEATHERBIT_API_KEY=your-weatherbit-api-key

# Google Maps API
EXPO_PUBLIC_MAPS_API_KEY=your-google-maps-api-key

# Error Tracking (optional)
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Analytics (optional)
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Note: Variables with EXPO_PUBLIC_ prefix are exposed in the client bundle.
# Do not store sensitive secrets here - use EAS Secrets for production builds.
