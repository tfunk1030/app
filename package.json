{
  "name": "aicaddypro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "setup": "yarn install && node -e \"const fs=require('fs'); if(!fs.existsSync('.env.local')){fs.copyFileSync('.env.example','.env.local');console.log('Created .env.local from template');}\"",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "todo:check": "node -e \"const{execSync}=require('child_process');const r=execSync('git grep -n -E \\\"TODO|FIXME|HACK|XXX\\\" -- \\\"*.ts\\\" \\\"*.tsx\\\" || true',{encoding:'utf8'});if(r){console.log('Tech debt items found:');console.log(r);process.exit(0);}else{console.log('No TODO/FIXME comments found');}\"",
    "jscpd": "jscpd ./src ./app --config .jscpd.json",
    "docs": "typedoc --out docs/api src/lib/*.ts src/hooks/*.ts",
    "align": "npx expo-doctor && npx expo install",
    "postinstall": "npx patch-package && node scripts/fix-rn-gradle-plugin.js && npm run rebuild:rn-gradle-plugin",
    "rebuild:rn-gradle-plugin": "node scripts/rebuild-rn-gradle-plugin.js",
    "setup:maven": "node_modules/@react-native/gradle-plugin/gradlew.bat :react-native-gradle-plugin:jar -x test && node -e \"const fs=require('fs');const path=require('path');const rnVersion=require('./node_modules/@react-native/gradle-plugin/package.json').version;const dir=`android/local-maven-repo/com/facebook/react/react-native-gradle-plugin/${rnVersion}`;fs.mkdirSync(dir,{recursive:true});fs.copyFileSync('node_modules/@react-native/gradle-plugin/react-native-gradle-plugin/build/libs/react-native-gradle-plugin.jar',path.join(dir,`react-native-gradle-plugin-${rnVersion}.jar`));fs.writeFileSync(path.join(dir,`react-native-gradle-plugin-${rnVersion}.pom`),`<?xml version=\\\"1.0\\\"?><project><modelVersion>4.0.0</modelVersion><groupId>com.facebook.react</groupId><artifactId>react-native-gradle-plugin</artifactId><version>${rnVersion}</version><packaging>jar</packaging></project>`);\"",
    "prepare": "husky",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "<rootDir>/components/__tests__/",
      "<rootDir>/.worktrees/"
    ],
    "maxWorkers": "50%",
    "verbose": true,
    "testTimeout": 10000,
    "randomize": true,
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/types.ts"
    ],
    "reporters": [
      "default"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.31",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "6.0.21",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "0.562.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.6.13",
    "react-native-purchases-ui": "^9.6.13",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "jscpd": "^4.0.0",
    "knip": "^5.0.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "3.4.17",
    "typedoc": "^0.27.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@expo/metro-runtime",
          "lucide-react-native"
        ]
      }
    }
  },
  "resolutions": {
    "eslint-plugin-react-native-a11y": "^3.5.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
