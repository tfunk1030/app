#!/bin/sh

# Run tests
npx jest --passWithNoTests

# Check for TODO/FIXME (info only, doesn't block commit)
echo "Checking for tech debt markers..."
git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | xargs -r grep -l -E 'TODO|FIXME|HACK|XXX' 2>/dev/null && echo "Note: Files with TODO/FIXME markers detected" || true
