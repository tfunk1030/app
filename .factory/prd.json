{
  "name": "Droid Factory",
  "description": "Automated droid orchestration for AICaddyPro quality pipelines",
  "branchName": "auto",
  "currentDroid": null,
  "currentTask": null,
  "strictMode": {
    "enabled": true,
    "pywwRequired": true,
    "minAttackVectors": 3,
    "dynamicTimestampRequired": true,
    "timestampCommand": "date -Iseconds",
    "fileAgeCommand": "git log -1 --format=%ci"
  },
  "validationChain": ["adversarial-validator"],
  "beforeAnyAction": [
    "Run: date -Iseconds",
    "Run: git log -1 --format=%ci [affected files]",
    "Search: current year guidelines/requirements if external"
  ],
  "priorityFocus": ["ui", "user-workflow", "spacing", "dead-code", "appstore"],
  "availableDroids": {
    "release-ops": {
      "description": "App Store submissions, EAS builds, release assets",
      "triggers": ["/appstore-blockers", "app store", "eas build", "release"],
      "tools": ["Read", "Edit", "Execute", "Grep", "Glob", "LS"]
    },
    "weather-integrator": {
      "description": "Weather API reliability, caching, offline behavior",
      "triggers": ["/weather-check", "weather api", "offline", "caching"],
      "tools": ["Read", "Execute", "Grep", "Glob", "LS"]
    },
    "security-privacy": {
      "description": "Security audit, privacy compliance, data handling",
      "triggers": ["/security-audit", "security", "privacy", "gdpr", "secrets"],
      "tools": ["Read", "Grep", "Glob", "LS", "Execute"]
    },
    "performance": {
      "description": "RN profiling, memory, startup, battery",
      "triggers": ["/perf-audit", "performance", "memory", "re-render", "battery"],
      "tools": ["Read", "Execute", "Grep", "Glob", "LS"]
    },
    "ui-reviewer": {
      "description": "UI/UX audits (audit-only, delegates fixes)",
      "triggers": ["/ui-audit", "ui review", "design review", "accessibility"],
      "tools": ["Read", "LS", "Grep", "Glob"]
    },
    "design-enforcer": {
      "description": "Fix UI issues after audit (implementation-only)",
      "triggers": ["/fix-card-soup", "fix ui", "design fix"],
      "tools": ["Read", "Edit", "Grep", "Glob", "LS"]
    },
    "physics-validator": {
      "description": "Golf physics calculations, ball flight, wind effects",
      "triggers": ["/physics-test", "physics", "calculations", "ball flight"],
      "tools": ["Read", "Edit", "Execute", "Grep", "Glob"]
    },
    "code-reviewer": {
      "description": "Code quality, TypeScript, patterns",
      "triggers": ["/pre-pr", "code review", "typescript", "lint"],
      "tools": ["Read", "Execute", "LS", "Grep", "Glob"]
    },
    "researcher": {
      "description": "Codebase exploration, context gathering",
      "triggers": ["research", "explore", "find", "understand"],
      "tools": ["Read", "LS", "Glob", "Grep"]
    },
    "adversarial-validator": {
      "description": "Meta-droid enforcing PYYW protocol on all conclusions",
      "triggers": ["/pyyw", "validate", "prove wrong"],
      "tools": ["Read", "Execute", "Grep", "Glob", "LS", "WebSearch"],
      "isMeta": true
    },
    "spacing-auditor": {
      "description": "Strict spacing audit with PYYW validation",
      "triggers": ["/strict-audit spacing", "spacing violations", "token audit"],
      "tools": ["Read", "Execute", "Grep", "Glob", "LS"]
    },
    "workflow-auditor": {
      "description": "User flow documentation and validation with PYYW",
      "triggers": ["/strict-audit workflow", "user flow", "workflow audit"],
      "tools": ["Read", "Execute", "Grep", "Glob", "LS"]
    },
    "dead-code-hunter": {
      "description": "Unused code detection with PYYW validation",
      "triggers": ["/strict-audit dead-code", "unused", "dead code"],
      "tools": ["Read", "Execute", "Grep", "Glob", "LS"],
      "requiresApproval": true
    },
    "appstore-validator": {
      "description": "App Store submission validation with live checks",
      "triggers": ["/appstore", "/strict-audit appstore", "submission"],
      "tools": ["Read", "Execute", "Grep", "Glob", "LS", "WebSearch"]
    }
  },
  "taskQueue": [],
  "completedTasks": [],
  "globalChecks": {
    "typecheck": {
      "command": "npx tsc --noEmit",
      "required": true,
      "lastRun": "2026-01-14T04:41:52Z",
      "passes": true
    },
    "lint": {
      "command": "npx expo lint",
      "required": false,
      "lastRun": "2026-01-14T04:41:52Z",
      "passes": true
    }
  },
  "settings": {
    "maxIterations": 20,
    "autoCommit": false,
    "requireTypecheck": true,
    "outputDir": ".factory/reviews"
  }
}
